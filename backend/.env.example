# Copy to .env (dev) / .env.test (tests). Never commit the real files.
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/safehaven"

# Comma-separated browser origins allowed by CORS. Leave unset locally; set in production,
# e.g. CORS_ORIGIN=https://safehaven.example.org
# CORS_ORIGIN=

# Set to 1 when running behind a load balancer / reverse proxy.
# TRUST_PROXY=1

# Enable the periodic alert scan (never runs under test). 0/unset = use the saved setting.
# ALERT_SCAN_INTERVAL_MS=60000

# Set false when running several instances and triggering the scan from an external scheduler instead.
# ALERT_SCHEDULER_ENABLED=true

# debug | info | warn | error (debug lines are hidden unless this is debug).
# LOG_LEVEL=info

# The seed truncates every table; with NODE_ENV=production it only runs when ALLOW_SEED=1.
# ALLOW_SEED=1
